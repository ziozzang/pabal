[Unit]
Description=Pabal SMTP test server and relay dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pabal
Group=pabal
ExecStart=/usr/local/bin/pabal -config /etc/pabal/config.json -state-dir /var/lib/pabal
EnvironmentFile=-/etc/pabal/credentials.env
StateDirectory=pabal
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
